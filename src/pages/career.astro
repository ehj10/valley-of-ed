---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Career | ${SITE_TITLE}`} description="Professional background of Valley of Ed." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Career</h1>
			<p>
				Revenue-focused finance and accounting professional with 5+ years of experience in 
				revenue tracking, reconciliation, and financial reporting. Recently completed a Data 
				Analytics for Business certificate at UC Irvine, adding skills in SQL, Python, and 
				Tableau. Currently exploring roles where I can combine my financial background with 
				my growing analytics skillset.
			</p>

			<h2>Experience</h2>

			<div class="job">
				<div class="job-header">
					<h3>Accounts Receivable Associate</h3>
					<span class="job-meta">NEED Financial Services — El Segundo, CA | Nov 2021 – Present</span>
				</div>
				<ul>
					<li>Manage revenue tracking for a $60M+ annual project portfolio, ensuring accurate accrual-based reporting across multi-month production cycles.</li>
					<li>Prepare and analyze weekly aging reports to identify trends, reconcile discrepancies, and support cash flow optimization.</li>
					<li>Investigate and resolve payment and revenue discrepancies, collaborating with production and finance teams to ensure accurate financial records.</li>
					<li>Partner with IT to identify reporting inefficiencies and implement process improvements, reducing manual data entry and improving data integrity.</li>
					<li>Act as financial liaison between departments, translating operational milestones into financial data and ensuring alignment on revenue recognition.</li>
				</ul>
			</div>

			<div class="job">
				<div class="job-header">
					<h3>Staff Accountant, Accounts Receivable</h3>
					<span class="job-meta">Behavior Frontiers LLC — Torrance, CA | Feb 2020 – Oct 2021</span>
				</div>
				<ul>
					<li>Audited and recorded $100K+ in daily medical insurance payments; resolved discrepancies and ensured accuracy across multiple payers.</li>
					<li>Developed Excel models (pivot tables, formulas) for account analysis, payment trend identification, and reporting.</li>
					<li>Collaborated with finance leadership to provide insights on payment patterns, revenue cycles, and cash flow.</li>
					<li>Monitored system performance and recommended process changes that improved workflow efficiency and reduced reconciliation errors.</li>
				</ul>
			</div>

			<div class="job">
				<div class="job-header">
					<h3>Assistant Manager</h3>
					<span class="job-meta">Sherwin-Williams Inc. — Long Beach, CA | May 2017 – Dec 2018</span>
				</div>
				<ul>
					<li>Analyzed sales and operational reports to project revenue and improve profitability.</li>
					<li>Mentored and trained staff, enhancing performance and collaboration.</li>
				</ul>
			</div>

			<h2>Education</h2>
			<div class="education">
				<p><strong>Data Analytics for Business Certificate</strong> — UC Irvine, 2026<br/>
				SQL, Python, Tableau, KNIME, Data Visualization, Business Intelligence</p>
				<p><strong>Bachelor of Arts, Economics</strong> — California State University, Long Beach, 2018</p>
			</div>

			<h2>Skills</h2>
			<div class="skills">
				<p><strong>Revenue & AR:</strong> Revenue tracking, accrual-based accounting, reconciliation, billing, collections</p>
				<p><strong>Data & Analytics:</strong> SQL, Python, Tableau, KNIME, Excel (Advanced), data visualization</p>
				<p><strong>Financial Reporting:</strong> Aging reports, variance analysis, KPI monitoring, month-end close support</p>
				<p><strong>Systems:</strong> QuickBooks, Acumatica ERP, Excel, Google Sheets</p>
				<p><strong>Soft Skills:</strong> Cross-functional collaboration, process improvement, attention to detail, problem-solving</p>
			</div>

			<h2>Contact</h2>
			<p>Reach me at <a href="mailto:ehero10@gmail.com">ehero10@gmail.com</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.job {
		margin-bottom: 2em;
	}
	.job-header h3 {
	font-style: italic;
}
	.job-header h3 {
		margin-bottom: 0.1em;
	}
	.job-meta {
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.education p {
		margin-bottom: 1em;
	}
	.skills p {
		margin-bottom: 0.5em;
	}
	ul {
		margin-top: 0.5em;
		padding-left: 1.5em;
	}
		ul li {
		margin-bottom: 0.5em;
	}
	h1, h2 {
		text-decoration: underline;
	}
</style>