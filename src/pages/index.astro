---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
	<h1>Valley of Ed</h1>
	<blockquote>
		<p>"...and so let Fortune turn her wheel, spinning it as she pleases, and the peasant turn his spade."</p>
		— Dante's Inferno
	</blockquote>
	<style>
	blockquote {
		text-align: center;
		font-size: 1em;
		margin-bottom: 2em;
		border-left: none;
		padding: 0;
	}
	blockquote p {
		font-style: italic;
	}
	.about {
		font-size: 1em;
		color: rgb(var(--gray-dark));
	}
</style>
	<div class="about">
		<p>
			
			Hey, I'm Ed. I have over five years of experience in finance and accounting, 
		with a focus on revenue tracking and financial analysis. I recently completed 
		a Data Analytics for Business certificate at UC Irvine, picking up skills in 
		SQL, Python, and Tableau along the way. I love finding ways to use data to 
		make financial operations smarter, and I'm currently looking for roles where 
		I can bring both sides of that background together.
		</p>
	</div>
</main>
		<Footer />
	</body>
</html>
